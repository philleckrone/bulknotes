<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <!-- Test host only: never deployed. Builds the plugin's Paratext-free sources into an exe. -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BulkNotesTests</RootNamespace>
    <AssemblyName>BulkNotesTestHost</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>5</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\BulkNotesPlugin\Model.cs">
      <Link>Model.cs</Link>
    </Compile>
    <Compile Include="..\..\BulkNotesPlugin\BulkNotesForm.cs">
      <Link>BulkNotesForm.cs</Link>
    </Compile>
    <Compile Include="..\..\BulkNotesPlugin\BulkRunner.cs">
      <Link>BulkRunner.cs</Link>
    </Compile>
    <Compile Include="..\..\BulkNotesPlugin\NoteFilter.cs">
      <Link>NoteFilter.cs</Link>
    </Compile>
    <Compile Include="..\..\BulkNotesPlugin\NoteReader.cs">
      <Link>NoteReader.cs</Link>
    </Compile>
    <Compile Include="..\..\BulkNotesPlugin\ProjectChooserForm.cs">
      <Link>ProjectChooserForm.cs</Link>
    </Compile>
    <Compile Include="..\..\BulkNotesPlugin\NotesFiles.cs">
      <Link>NotesFiles.cs</Link>
    </Compile>
    <Compile Include="..\..\BulkNotesPlugin\ProjectUsers.cs">
      <Link>ProjectUsers.cs</Link>
    </Compile>
    <Compile Include="..\..\BulkNotesPlugin\Settings.cs">
      <Link>Settings.cs</Link>
    </Compile>
    <Compile Include="..\..\BulkNotesPlugin\Strings.cs">
      <Link>Strings.cs</Link>
    </Compile>
    <Compile Include="FolderNotes.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
